# Get a key at https://console.cloud.google.com -> APIs & Services -> enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# How many recent videos to analyze (max 200)
MAX_VIDEOS=50

# Timezone used for upload-day / month grouping
TIMEZONE=Asia/Jerusalem

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
